---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import fontSubset from "../generated/font-subset.json";

interface Props {
    title: string;
    description?: string;
}

const { title, description = "一个极简主义的个人博客" } = Astro.props;
// 构建期生成的单文件字体子集（scripts/subset-font.mjs）
const fontFaceCss = `@font-face{font-family:"LXGW Bright Code";src:local("LXGW Bright Code"),url("${fontSubset.url}") format("woff2");font-style:normal;font-weight:400;font-display:swap;}`;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <script is:inline>
            (function () {
                const theme = (() => {
                    if (
                        typeof localStorage !== "undefined" &&
                        localStorage.getItem("theme")
                    ) {
                        return localStorage.getItem("theme");
                    }
                    if (
                        window.matchMedia("(prefers-color-scheme: dark)")
                            .matches
                    ) {
                        return "dark";
                    }
                    return "light";
                })();
                document.documentElement.setAttribute("data-theme", theme);
            })();
        </script>
        <link
            rel="preload"
            href={fontSubset.url}
            as="font"
            type="font/woff2"
            crossorigin
        />
        <Fragment set:html={`<style>${fontFaceCss}</style>`} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="RSS"
            href={new URL("rss.xml", Astro.site).toString()}
        />
        <title>{title}</title>
    </head>
    <body>
        <slot name="progress" />
        <div class="max-w-375 mx-auto px-6 pb-10 min-h-screen flex flex-col">
            <SiteHeader />
            <main class="flex-1">
                <slot />
            </main>
            <footer
                class="mt-20 pt-8 text-sm text-text-secondary flex justify-center items-center gap-4"
            >
                <span>{new Date().getFullYear()} 我的日志</span>
                <a
                    href={new URL("rss.xml", Astro.site).toString()}
                    class="rss-link"
                    aria-label="RSS"
                >
                    <svg
                        width="12"
                        height="12"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M4 11a9 9 0 0 1 9 9"></path>
                        <path d="M4 4a16 16 0 0 1 16 16"></path>
                        <circle cx="4" cy="20" r="2"></circle>
                    </svg>
                </a>
            </footer>
        </div>
    </body>
</html>

<style>
    .rss-link {
        color: var(--color-text-secondary);
        border-bottom: none;
        display: flex;
        align-items: center;
        opacity: 0.7;
        transition:
            opacity 0.2s ease,
            color 0.2s ease;
    }

    .rss-link:hover {
        opacity: 1;
        color: var(--color-text-primary);
    }
</style>
