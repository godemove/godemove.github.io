<button id="theme-toggle" data-mode="system" aria-label="切换主题" title="跟随系统" class="w-8 h-8 rounded-full flex items-center justify-center text-text-secondary hover:text-text transition-colors cursor-pointer border-0 bg-transparent p-1">
  <svg class="icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
  <svg class="icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
  <svg class="icon-system" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
</button>

<script is:inline>
  (function() {
    const toggle = document.getElementById('theme-toggle');
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    function getMode() {
      const saved = localStorage.getItem('theme');
      return saved === 'light' || saved === 'dark' ? saved : 'system';
    }

    function applyTheme() {
      const mode = getMode();
      const theme = mode === 'system' ? (media.matches ? 'dark' : 'light') : mode;
      root.setAttribute('data-theme', theme);
      toggle?.setAttribute('data-mode', mode);
      const labels = { system: '跟随系统', light: '亮色主题', dark: '暗色主题' };
      toggle?.setAttribute('title', labels[mode]);
    }

    toggle?.addEventListener('click', () => {
      const mode = getMode();
      const next = mode === 'system' ? 'light' : mode === 'light' ? 'dark' : 'system';
      if (next === 'system') {
        localStorage.removeItem('theme');
      } else {
        localStorage.setItem('theme', next);
      }
      applyTheme();
    });

    media.addEventListener('change', () => {
      if (getMode() === 'system') applyTheme();
    });

    applyTheme();
  })();
</script>

<style>
  .icon-light,
  .icon-dark,
  .icon-system {
    display: none;
  }

  #theme-toggle[data-mode='light'] .icon-light {
    display: block;
  }

  #theme-toggle[data-mode='dark'] .icon-dark {
    display: block;
  }

  #theme-toggle[data-mode='system'] .icon-system {
    display: block;
  }
</style>
